[0.009367, "o", "\u001b[61;88r\u001b[1;1H\u001b[21S\u001b[67d# HELP jumpstarter_operation_duration_seconds Duration of each operation.\r\n# TYPE jumpstarter_operation_duration_seconds histogram\u001b[K\r\n# HELP jumpstarter_operation_errors Errors by class (timeout, device, ...).\u001b[K\r\n# TYPE jumpstarter_operation_errors counter\u001b[K\r\n# HELP jumpstarter_stream_bytes Bytes transferred (tx/rx) on streams.\u001b[K\r\n# TYPE jumpstarter_stream_bytes counter\u001b[K\r\n# HELP jumpstarter_active_sessions Currently active lease sessions.\u001b[K\r\n# TYPE jumpstarter_active_sessions gauge\u001b[K\r\njumpstarter_active_sessions{exporter=\"sidekick-t450s\"} 0.0\u001b[K\r\nrkieley@sidekick-t450s:/wip/src/github.com/jumpstarter-dev/jumpstarter$ echo LOCAL_IDLE_DONE\u001b[K\r\nLOCAL_IDLE_DONE\u001b[K\r\nrkieley@sidekick-t450s:/wip/src/github.com/jumpstarter-dev/jumpstarter$\u001b[K\r\nrkieley@sidekick-t450s:/wip/src/github.com/jumpstarter-dev/jumpstarter$ echo \"=== LOCAL LEASE /metrics $(date -u +%H:%M:%SZ) ===\"\u001b[K\r\n=== LOCAL LEASE /metrics 10:27:08Z ===\u001b[K\r\nrkieley@sidekick-t450s:/wip/src/github.com/jumpstarter-dev/jumpstarter$ curl -fsS http://127.0.0.1:41451/metrics | grep -E \"^jumpstarter_\"\u001b[K\r\njumpstarter_active_sessions{exporter=\"sidekick-t450s\"} 1.0\u001b[K\r\nrkieley@sidekick-t450s:/wip/src/github.com/jumpstarter-dev/jumpstarter$ echo LOCAL_LEASE_DONE\u001b[K\r\nLOCAL_LEASE_DONE\u001b[K\r\nrkieley@sidekick-t450s:/wip/src/github.com/jumpstarter-dev/jumpstarter$\u001b[K\r\nrkieley@sidekick-t450s:/wip/src/github.com/jumpstarter-dev/jumpstarter$\u001b[K\r\n\u001b[K\u001b[1;89r\u001b[24;27H"]
